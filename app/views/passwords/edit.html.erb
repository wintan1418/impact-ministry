<% content_for :title, "Choose a new password" %>

<section class="container-read" style="padding-top: 96px; padding-bottom: 120px;">
  <p class="meta">Account</p>
  <h1 class="display mt-4" style="font-size: clamp(36px, 4.5vw, 52px); line-height: 1.05;">
    Choose a new password.
  </h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-10" do |form| %>
    <div class="space-y-6">
      <div>
        <%= form.label :password, "New password", class: "meta block mb-2" %>
        <%= form.password_field :password,
                                 required: true,
                                 autocomplete: "new-password",
                                 placeholder: "your new password",
                                 maxlength: 72,
                                 "aria-label": "New password",
                                 class: "input" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "meta block mb-2" %>
        <%= form.password_field :password_confirmation,
                                 required: true,
                                 autocomplete: "new-password",
                                 placeholder: "repeat it",
                                 maxlength: 72,
                                 "aria-label": "Confirm new password",
                                 class: "input" %>
      </div>

      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
