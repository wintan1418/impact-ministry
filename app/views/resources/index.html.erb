<% content_for :title, "Resources — IMPACT Ministry" %>
<% content_for :description, "A small library of useful things — devotional guides, study notes, sermons, and curriculum. Free, downloadable, written for everyday use." %>

<%# ============================================================
     HERO
     ============================================================ %>
<section class="pt-10 md:pt-16 pb-10 md:pb-14">
  <div class="container-page">
    <p class="meta">Resources</p>
    <h1 class="display m-0 mt-3" style="font-size: clamp(40px, 6vw, 72px); line-height: 1.0; letter-spacing: -0.02em;">
      A small library<br>
      <span class="italic font-normal">of useful things.</span>
    </h1>
    <p class="reading mt-6 max-w-[560px]" style="font-size: 18px;">
      Devotional guides, study notes, sermons, curriculum, and the occasional playlist. Free, downloadable, written for everyday use.
    </p>
  </div>
</section>

<%# ============================================================
     SEARCH + CATEGORY FILTER
     ============================================================ %>
<section class="sticky top-[72px] z-40 border-b"
         style="padding: 24px 0 22px; background: rgba(250,247,242,0.92); backdrop-filter: blur(6px); border-color: var(--color-olive-15);">
  <div class="container-page flex flex-wrap items-center justify-between gap-6">
    <div class="flex gap-2 flex-wrap">
      <%= link_to "All", resources_path,
            class: "chip #{'chip-active' if @category.blank?}" %>
      <% @categories.each do |cat| %>
        <%= link_to cat.tr("_", " ").titleize, resources_path(category: cat),
              class: "chip #{'chip-active' if @category == cat}" %>
      <% end %>
    </div>

    <%= form_with url: resources_path, method: :get, local: true,
                  data: { turbo_frame: "_top" },
                  class: "flex items-center gap-2" do |f| %>
      <% if @category.present? %>
        <%= f.hidden_field :category, value: @category %>
      <% end %>
      <%= f.text_field :q, value: @query, placeholder: "Search the library",
            "aria-label": "Search resources",
            class: "input", style: "min-width: 240px; font-size: 14px; padding: 10px 16px;" %>
    <% end %>
  </div>
</section>

<%# ============================================================
     FEATURED
     ============================================================ %>
<% if @featured.any? %>
  <section class="pt-12 md:pt-16 pb-8 md:pb-12">
    <div class="container-page">
      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6 md:mb-8">
        <p class="meta">Featured</p>
        <p class="meta" style="color: var(--color-olive);">Hand-picked for this season</p>
      </div>

      <div class="grid gap-6 md:gap-8 md:grid-cols-3">
        <% @featured.each do |resource| %>
          <%= link_to resource_path(resource.slug), class: "card card-hover overflow-hidden p-0 block" do %>
            <div class="relative" style="height: 220px;">
              <%= image_tag photo_url(resource.cover_photo_slug.presence || "open-bible", w: 800, h: 560),
                            alt: "Cover image for #{resource.title}",
                            class: "w-full h-full",
                            style: "object-fit: cover;" %>
              <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 45%, rgba(27,42,78,0.55));"></div>
              <div class="absolute left-5 bottom-4" style="color: var(--color-cream);">
                <p class="meta m-0" style="color: rgba(250,247,242,0.85);">
                  <%= resource.category_label %>
                </p>
              </div>
            </div>
            <div class="p-6 md:p-7">
              <h3 class="display m-0" style="font-size: clamp(22px, 2.6vw, 28px); line-height: 1.15; letter-spacing: -0.01em;">
                <%= resource.title %>
              </h3>
              <% if resource.description.present? %>
                <p class="mt-3 m-0" style="font-family: var(--font-reading); font-size: 15px; line-height: 1.6; color: var(--color-ink); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= truncate(resource.description.to_s, length: 180) %>
                </p>
              <% end %>
              <p class="mt-5 m-0" style="font-size: 13px; color: var(--color-crimson); font-weight: 500;">
                Get the resource →
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ============================================================
     PER-CATEGORY SECTIONS
     ============================================================ %>
<% if @by_category.any? %>
  <% @by_category.each do |category, resources_list| %>
    <section class="pt-10 md:pt-12 pb-4 md:pb-6">
      <div class="container-page">
        <div class="flex items-baseline justify-between flex-wrap gap-3 mb-5 md:mb-6">
          <h2 class="display m-0" style="font-size: clamp(24px, 3vw, 32px); letter-spacing: -0.01em;">
            <%= category.to_s.tr("_", " ").titleize %>
          </h2>
          <p class="meta" style="color: var(--color-olive);">
            <%= pluralize(resources_list.size, "resource") %>
          </p>
        </div>

        <div class="grid gap-5 md:gap-6 md:grid-cols-2 lg:grid-cols-3">
          <% resources_list.each_with_index do |resource, i| %>
            <%= link_to resource_path(resource.slug), class: "card card-hover overflow-hidden p-0 block",
                  style: "animation: pageEnter 400ms var(--ease-impact) #{i * 40}ms both;" do %>
              <div class="relative" style="height: 180px;">
                <%= image_tag photo_url(resource.cover_photo_slug.presence || "open-bible", w: 600, h: 440),
                              alt: "Cover image for #{resource.title}",
                              class: "w-full h-full",
                              style: "object-fit: cover;" %>
              </div>
              <div class="p-5 md:p-6">
                <p class="meta m-0"><%= resource.category_label %></p>
                <h3 class="display m-0 mt-2" style="font-size: 20px; line-height: 1.2; letter-spacing: -0.01em;">
                  <%= resource.title %>
                </h3>
                <% if resource.description.present? %>
                  <p class="mt-3 m-0" style="font-family: var(--font-reading); font-size: 14px; line-height: 1.55; color: var(--color-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= truncate(resource.description.to_s, length: 140) %>
                  </p>
                <% end %>
                <p class="mt-4 m-0" style="font-size: 13px; color: var(--color-crimson); font-weight: 500;">
                  Get the resource →
                </p>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
<% elsif @featured.empty? %>
  <%# ============================================================
       EMPTY STATE
       ============================================================ %>
  <section class="pt-10 md:pt-16 pb-20 md:pb-24">
    <div class="container-page">
      <div class="card p-10 md:p-12 text-center">
        <p class="meta mb-3">The shelves are still being filled</p>
        <h2 class="display m-0" style="font-size: clamp(28px, 4vw, 40px);">
          More resources are on the way.
        </h2>
        <p class="reading mt-4 max-w-[480px] mx-auto">
          Leave your email and we'll write when the next one drops. We don't fill the library with filler.
        </p>
        <div class="mt-6 max-w-[420px] mx-auto">
          <%= render "shared/email_capture", source: "inline" %>
        </div>
      </div>
    </div>
  </section>
<% end %>

<div class="pb-16"></div>
