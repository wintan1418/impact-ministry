<% content_for :title, "IMPACT Ministry — A short, true word, every morning" %>
<% content_for :description, "Daily devotionals, podcast, and prayer from a small Mississippi ministry. A short, true word before sunrise." %>

<%# ============================================================
     HERO — today's devotional title, scripture, teaser, CTA
     ============================================================ %>
<section class="pt-10 md:pt-16 pb-16 md:pb-24 lg:pb-28 relative">
  <%# Vertical scripture marginalia — editorial fingerprint, md+ only. %>
  <% hero_ref = (@today_devotional&.scripture_reference || "Habakkuk 2:1–4").to_s %>
  <span class="scripture-mark" aria-hidden="true">
    <%= hero_ref %> · The Morning Word
  </span>

  <div class="container-page">
    <div class="grid gap-12 md:gap-16 lg:gap-20 lg:grid-cols-[1.05fr_1fr] items-center">
      <div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-6 sm:mb-7 fade-up">
          <span class="meta">Today · <%= Date.current.strftime("%A, %B %-d") %></span>
          <span class="inline-block" style="width: 4px; height: 4px; border-radius: 9999px; background: var(--color-olive-30);"></span>
          <span class="scripture draw" style="font-size: 14px; color: var(--color-olive);"><%= hero_ref %></span>
        </div>

        <h1 class="display fade-up m-0" style="font-size: clamp(48px, 6.5vw, 88px); line-height: 0.98; animation-delay: 120ms;">
          <% if @today_devotional %>
            <%= @today_devotional.title %>
          <% else %>
            When the<br><span class="italic font-normal">vision</span> tarries.
          <% end %>
        </h1>

        <p class="reading fade-up mt-7 max-w-[520px]" style="animation-delay: 260ms;">
          <% if @today_devotional&.excerpt.present? %>
            <%= @today_devotional.excerpt %>
          <% else %>
            Waiting is not the absence of God's word. It is the long, slow work of trusting that what He has spoken still stands — even when the answer takes its time.
          <% end %>
        </p>

        <div class="fade-up mt-10 flex flex-wrap items-center gap-5 sm:gap-7" style="animation-delay: 380ms;">
          <%= link_to devotionals_today_path, class: "btn btn-primary breath", style: "padding: 16px 28px; font-size: 15px;" do %>
            Read today's devotional <span aria-hidden="true">→</span>
          <% end %>
          <% if @tomorrow_book.present? %>
            <%= link_to devotionals_path, class: "tomorrow-chip", title: "A look at tomorrow's word" do %>
              <span>Tomorrow ·</span>
              <strong><%= @tomorrow_book %></strong>
            <% end %>
          <% end %>
        </div>

        <%# Morning status — hairline-divided micro-stats. Living and specific. %>
        <div class="morning-status fade-up mt-10" style="animation-delay: 500ms;">
          <div>
            <strong>🌅 <%= @sunrise_time %></strong>
            sunrise in Jackson
          </div>
          <div>
            <strong><%= number_with_delimiter(@readers_this_morning) %></strong>
            have read this morning
          </div>
          <div>
            <strong><%= (time_ago_in_words(@tomorrow_send_at) rescue "14h") %></strong>
            until tomorrow's word
          </div>
        </div>
      </div>

      <%# Right column — breaking-glass photo carousel.
          6 editorial photographs cycle every ~4.4s. Outgoing slide clip-
          paths into a jagged shard cluster while a cream sheen sweeps
          across; the next image cross-fades up underneath. %>
      <%
        hero_slides = [
          { slug: "delta-sunrise",  kicker: "The Yazoo at dawn",     title: "5:48am. The river still." },
          { slug: "open-bible",     kicker: "Open every morning",    title: "A book older than our hurry." },
          { slug: "morning-desk",   kicker: "Two minutes, two sips", title: "Coffee, journal, quiet." },
          { slug: "praying-hands",  kicker: "Folded for a friend",   title: "Carrying weight, briefly." },
          { slug: "path-pines",     kicker: "A long walk to think",  title: "Mississippi pines, slow steps." },
          { slug: "doorway-light",  kicker: "Light through a door",  title: "Where the morning enters." }
        ]
      %>
      <div class="hero-shards fade-up"
           data-controller="hero-shards"
           style="animation-delay: 220ms;"
           aria-roledescription="carousel"
           aria-label="Six morning images of the ministry's daily rhythm">
        <% hero_slides.each_with_index do |s, i| %>
          <div class="hero-shard <%= 'is-active' if i.zero? %>"
               data-hero-shards-target="slide"
               data-kicker="<%= s[:kicker] %>"
               data-title="<%= s[:title] %>"
               aria-hidden="<%= i.zero? ? 'false' : 'true' %>">
            <%= image_tag photo_url(s[:slug], w: 900, h: 1100),
                  alt: s[:kicker],
                  loading: (i.zero? ? "eager" : "lazy") %>
          </div>
        <% end %>

        <div class="hero-shards-caption">
          <span class="hero-shards-kicker" data-hero-shards-target="kicker"><%= hero_slides.first[:kicker] %></span>
          <span class="hero-shards-title"  data-hero-shards-target="title"><%= hero_slides.first[:title] %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ============================================================
     LATEST DEVOTIONALS — magazine archive strip
     ============================================================ %>
<% if @recent_devotionals&.any? %>
  <section class="section-linen pt-14 md:pt-16 pb-16 md:pb-20">
    <div class="container-page">
      <div class="flex justify-between items-baseline mb-7 flex-wrap gap-4">
        <div>
          <p class="meta">Lately</p>
          <h2 class="display m-0 mt-2" style="font-size: clamp(26px, 3.4vw, 40px); letter-spacing: -0.01em;">
            What we wrote this week.
          </h2>
        </div>
        <%= link_to "Browse the archive →", devotionals_path, class: "ulink", style: "font-size: 14px; color: var(--color-navy);" %>
      </div>

      <div class="dev-strip">
        <% @recent_devotionals.each do |d| %>
          <%= link_to devotional_path(d.slug), class: "dev-strip-card" do %>
            <span class="dev-strip-date"><%= d.scheduled_for.strftime("%a · %b %-d") %></span>
            <h3 class="dev-strip-title"><%= d.title %></h3>
            <% if d.scripture_reference.present? %>
              <span class="dev-strip-ref"><%= d.scripture_reference %></span>
            <% end %>
            <% if d.excerpt.present? %>
              <p class="m-0" style="font-family: var(--font-reading); font-size: 14px; line-height: 1.55; color: var(--color-ink);">
                <%= truncate(d.excerpt, length: 110) %>
              </p>
            <% end %>
            <div class="dev-strip-foot">
              <span>2 min · read</span>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ============================================================
     EMAIL CAPTURE — framed as invitation
     ============================================================ %>
<section class="pb-20 md:pb-28 lg:pb-36">
  <div class="container-page">
    <div class="grid gap-12 md:gap-16 lg:gap-20 lg:grid-cols-[1fr_1.05fr] items-center">
      <div>
        <p class="meta mb-4 md:mb-5">The morning word</p>
        <h2 class="display m-0" style="font-size: clamp(36px, 5vw, 64px); line-height: 1.0;">
          Start your day<br><span class="italic font-normal">with us.</span>
        </h2>
        <p class="reading mt-5 max-w-[480px]" style="font-size: 18px;">
          A short, true word in your inbox before sunrise. Two minutes to read. The rest of the day is yours.
        </p>

        <div class="mt-7 md:mt-8 max-w-[480px]">
          <%= render "shared/email_capture", source: "inline" %>
        </div>

        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-5 text-[13px]" style="color: var(--color-olive);">
          <div>
            <strong class="block" style="color: var(--color-navy); font-family: var(--font-serif); font-size: 22px; font-weight: 500;">
              <%= number_with_delimiter(@readers_this_week) %>
            </strong>
            readers this week
          </div>
          <div>
            <strong class="block" style="color: var(--color-navy); font-family: var(--font-serif); font-size: 22px; font-weight: 500;">
              <%= @open_rate_percent %>%
            </strong>
            open rate
          </div>
          <div>
            <strong class="block" style="color: var(--color-navy); font-family: var(--font-serif); font-size: 22px; font-weight: 500;">
              <%= @average_read_minutes %> min
            </strong>
            average read
          </div>
        </div>
      </div>

      <%# Right — quiet visual rest %>
      <%= image_tag photo_url("morning-desk", w: 720, h: 860), alt: "A journal and coffee on a wooden desk in morning light", class: "w-full", style: "aspect-ratio: 5 / 6; max-height: 520px; border-radius: var(--radius-image); object-fit: cover;" %>
    </div>
  </div>
</section>

<%# ============================================================
     MISSION PULL-QUOTE
     ============================================================ %>
<section class="pb-20 md:pb-28 lg:pb-36">
  <div class="mx-auto px-5 md:px-8" style="max-width: 920px;">
    <p class="meta text-center mb-8 md:mb-9">What we believe</p>
    <blockquote class="m-0 text-center" style="font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(24px, 4vw, 44px); line-height: 1.25; color: var(--color-navy); letter-spacing: -0.01em;">
      We believe scripture is older than our hurry, kinder than our news cycles, and steady enough to carry a person through a Tuesday — every Tuesday, for the rest of their life.
    </blockquote>
    <div class="text-center mt-8 md:mt-9">
      <%= link_to "Read our statement of faith", beliefs_page_path, class: "ulink", style: "color: var(--color-crimson); font-size: 14px; font-weight: 500;" %>
    </div>
  </div>
</section>

<%# ============================================================
     PODCAST — Phase 2 will render real episode; placeholder here
     ============================================================ %>
<section class="pb-20 md:pb-28 lg:pb-36">
  <div class="container-page">
    <div class="flex justify-between items-baseline mb-7 flex-wrap gap-4">
      <div>
        <p class="meta">The IMPACT Podcast</p>
        <h2 class="display m-0 mt-2" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.01em;">
          Conversations on faith, work, and waiting.
        </h2>
      </div>
      <a href="#" class="ulink" style="font-size: 14px;">All episodes →</a>
    </div>

    <% podcast_card_href = @latest_episode ? podcast_episode_path(@latest_episode.slug) : podcast_path %>
    <%= link_to podcast_card_href, class: "card card-hover overflow-hidden p-0", style: "display: grid; grid-template-columns: 1fr;" do %>
      <div class="grid lg:grid-cols-[1.3fr_1fr]">
        <div class="relative" style="min-height: 280px;">
          <%= image_tag photo_url((@latest_episode&.cover_photo_slug.presence) || "microphone", w: 1000, h: 700),
                        alt: @latest_episode ? "Cover for #{@latest_episode.title}" : "Microphone in warm studio light",
                        class: "w-full h-full",
                        style: "object-fit: cover; min-height: 280px;" %>
          <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 40%, rgba(27,42,78,0.7));"></div>
          <div class="absolute left-5 bottom-5 md:left-7 md:bottom-7" style="color: var(--color-cream);">
            <p class="meta m-0" style="color: rgba(250,247,242,0.7);">
              <% if @latest_episode %>
                Season <%= @latest_episode.season %> · Episode <%= @latest_episode.episode_number %>
                <% if @latest_episode.duration_label %> · <%= @latest_episode.duration_label %><% end %>
              <% else %>
                Season 1 · drops mid-2026
              <% end %>
            </p>
          </div>
          <div class="absolute right-5 bottom-5 md:right-7 md:bottom-7 flex items-center justify-center"
               style="width: 56px; height: 56px; border-radius: 9999px; background: var(--color-crimson); color: var(--color-cream); box-shadow: var(--shadow-soft);"
               aria-hidden="true">▶</div>
        </div>
        <div class="p-6 md:p-10 lg:p-12 flex flex-col justify-center" style="background: var(--color-linen);">
          <h3 class="display m-0" style="font-size: clamp(24px, 3vw, 36px); letter-spacing: -0.02em; line-height: 1.1;">
            <%= @latest_episode&.title || "Conversations on faith, work, and waiting." %>
          </h3>
          <% if @latest_episode&.guest_names&.any? %>
            <p class="meta mt-3" style="color: var(--color-olive);">with <%= @latest_episode.guest_names.to_sentence %></p>
          <% end %>
          <p class="m-0 mt-4" style="font-family: var(--font-reading); font-size: 15px; line-height: 1.65;">
            <%= truncate(@latest_episode&.description.to_s, length: 220).presence ||
                "A slow conversation series with pastors, writers, and neighbors trying to live well in a hurried decade." %>
          </p>
          <div class="mt-6 md:mt-7 flex gap-2 flex-wrap">
            <span class="chip">Spotify</span>
            <span class="chip">Apple Podcasts</span>
            <span class="chip">YouTube</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# ============================================================
     ON THE WALL — recent public prayer requests
     ============================================================ %>
<% if @recent_prayer_requests&.any? %>
  <section class="section-linen pt-14 md:pt-16 pb-16 md:pb-20">
    <div class="container-page">
      <div class="flex justify-between items-baseline mb-7 flex-wrap gap-4">
        <div>
          <p class="meta">On the wall this week</p>
          <h2 class="display m-0 mt-2" style="font-size: clamp(26px, 3.4vw, 40px); letter-spacing: -0.01em;">
            Carry someone today.
          </h2>
        </div>
        <%= link_to "See the whole wall →", pray_path, class: "ulink", style: "font-size: 14px; color: var(--color-navy);" %>
      </div>

      <div class="grid gap-5 md:gap-6 md:grid-cols-3">
        <% @recent_prayer_requests.each do |pr| %>
          <article class="pulse-card">
            <p class="pulse-body">
              "<%= pr.body %>"
            </p>
            <div class="pulse-foot">
              <span><%= pr.is_anonymous? ? "Anonymous" : (pr.name.presence || "A reader") %> · <%= time_ago_in_words(pr.created_at) %> ago</span>
              <span class="pulse-prayed-count"><%= pluralize(pr.prayed_count, "prayer") %></span>
            </div>
          </article>
        <% end %>
      </div>

      <div class="mt-10 text-center">
        <%= link_to pray_path, class: "ulink", style: "font-size: 14px; color: var(--color-crimson); font-weight: 500;" do %>
          Add your request, or pray with someone here <span aria-hidden="true">→</span>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ============================================================
     TESTIMONY — full-width navy band
     ============================================================ %>
<section class="py-20 md:py-24 lg:py-28" style="background: var(--color-navy); color: var(--color-cream);">
  <div class="container-page">
    <p class="meta text-center" style="color: rgba(250,247,242,0.6); margin-bottom: 32px;">One story</p>
    <div class="grid gap-10 md:gap-14 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] max-w-[920px] mx-auto items-center">
      <% if @featured_testimony&.photo&.attached? %>
        <%= image_tag @featured_testimony.photo,
              alt: "Portrait of #{@featured_testimony.display_name}",
              class: "mx-auto md:mx-0 w-3/4 sm:w-1/2 md:w-full",
              style: "aspect-ratio: 1/1.15; border-radius: 16px; min-height: 180px; object-fit: cover;" %>
      <% else %>
        <%= image_tag photo_url("portrait-man", w: 520, h: 600),
              alt: @featured_testimony ? "Portrait of #{@featured_testimony.display_name}" : "Portrait of Marcus, a subscriber from Jackson, Mississippi",
              class: "mx-auto md:mx-0 w-3/4 sm:w-1/2 md:w-full",
              style: "aspect-ratio: 1/1.15; border-radius: 16px; min-height: 180px; object-fit: cover;" %>
      <% end %>
      <div>
        <blockquote class="m-0 text-center md:text-left" style="font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(20px, 2.4vw, 32px); line-height: 1.35; color: var(--color-cream);">
          <% if @featured_testimony %>
            "<%= @featured_testimony.pull_quote %>"
          <% else %>
            "I hadn't opened a Bible in nine years. The morning email didn't ask me to. It just showed up, gentle, like a friend who knew I'd be back."
          <% end %>
        </blockquote>
        <div class="mt-6 md:mt-7 flex flex-wrap items-center justify-center md:justify-start gap-2 sm:gap-3 text-[13px]" style="color: rgba(250,247,242,0.7);">
          <% if @featured_testimony %>
            <span style="font-family: var(--font-serif); color: var(--color-cream); font-size: 16px;"><%= @featured_testimony.display_name %></span>
            <% if @featured_testimony.location.present? %>
              <span>·</span>
              <span><%= @featured_testimony.location %></span>
            <% end %>
          <% else %>
            <span style="font-family: var(--font-serif); color: var(--color-cream); font-size: 16px;">Marcus L.</span>
            <span>·</span>
            <span>Jackson, MS · subscriber since Jan 2026</span>
          <% end %>
        </div>
        <div class="mt-7 md:mt-8 flex justify-center md:justify-start">
          <%= link_to testimonies_path, class: "ulink", style: "color: rgba(250,247,242,0.85); font-size: 14px;" do %>
            Read more stories <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ============================================================
     GIVE INVITATION — dignified, small. Three tiles + quiet CTA.
     ============================================================ %>
<section class="py-20 md:py-24 lg:py-28">
  <div class="container-page">
    <div class="mx-auto text-center mb-10 md:mb-12" style="max-width: 720px;">
      <p class="meta mb-4">Where it goes</p>
      <p class="m-0" style="font-family: var(--font-serif); font-style: italic; font-size: clamp(20px, 2.4vw, 28px); color: var(--color-navy); line-height: 1.4;">
        IMPACT runs on the generosity of people<br class="hidden sm:inline">who've been impacted.
      </p>
    </div>

    <div class="grid gap-5 md:gap-6 md:grid-cols-3 mx-auto" style="max-width: 980px;">
      <%= link_to give_path, class: "give-tile" do %>
        <span class="give-tile-kicker">Devotionals</span>
        <p class="give-tile-body">Daily writing, editing, and email delivery — the morning word reaches every subscriber free of charge.</p>
      <% end %>
      <%= link_to give_path, class: "give-tile" do %>
        <span class="give-tile-kicker">Partner churches</span>
        <p class="give-tile-body">Small grants to congregations doing faithful work in towns most ministry money never reaches.</p>
      <% end %>
      <%= link_to give_path, class: "give-tile" do %>
        <span class="give-tile-kicker">Local need</span>
        <p class="give-tile-body">A small fund that pays a neighbor's rent or grocery bill the same week she asks.</p>
      <% end %>
    </div>

    <div class="text-center mt-10 md:mt-12">
      <%= link_to give_path, class: "ulink", style: "color: var(--color-crimson); font-size: 14px; font-weight: 500;" do %>
        Learn how to give <span aria-hidden="true">→</span>
      <% end %>
    </div>
  </div>
</section>
