<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <title><%= content_for?(:title) ? yield(:title) : "IMPACT Ministry" %></title>
  </head>
  <body style="margin:0; padding:0; background-color:#FAF7F2; color:#1F1B16; font-family:Helvetica,Arial,sans-serif; font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased;">
    <!-- Preheader — inbox preview text, hidden in the body -->
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#FAF7F2;">
      <%= content_for?(:preheader) ? yield(:preheader) : "A short word from IMPACT Ministry." %>
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FAF7F2;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:600px; background-color:#FAF7F2;">

            <!-- Header -->
            <tr>
              <td style="padding:0 8px 24px 8px; border-bottom:1px solid rgba(139,115,85,0.30);">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left" style="font-family:Georgia,'Times New Roman',serif; font-size:22px; font-weight:500; letter-spacing:-0.01em; color:#1B2A4E;">
                      IMPACT Ministry
                    </td>
                    <td align="right" style="font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8B7355;">
                      A short, true word
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px 8px; font-family:Helvetica,Arial,sans-serif; font-size:16px; line-height:1.65; color:#1F1B16;">
                <%= yield %>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:24px 8px 8px 8px; border-top:1px solid rgba(139,115,85,0.30); font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.6; color:#8B7355;">
                <p style="margin:0 0 6px 0; color:#8B7355;">
                  IMPACT Ministry &middot; Mississippi
                </p>
                <p style="margin:0 0 12px 0; color:#8B7355;">
                  We&rsquo;re praying with you. You can write back any time &mdash;
                  this inbox is read by a person.
                </p>
                <p style="margin:0; color:#8B7355;">
                  <%= link_to "Unsubscribe", root_url, style: "color:#8B7355; text-decoration:underline;" %>
                  &nbsp;&middot;&nbsp;
                  <%= link_to "Visit the site", root_url, style: "color:#8B7355; text-decoration:underline;" %>
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
