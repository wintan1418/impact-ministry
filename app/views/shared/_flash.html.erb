<%# Inline page-level flash. Errors render inline, never as a toast (CLAUDE.md §3). %>
<% if notice.present? %>
  <div class="container-page mt-6" role="status">
    <div class="card" style="background: rgba(255,255,255,0.7); padding: 14px 18px; color: var(--color-navy);">
      <%= notice %>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="container-page mt-6" role="alert">
    <div class="card" style="background: rgba(200,16,46,0.06); border-color: var(--color-crimson); padding: 14px 18px; color: var(--color-crimson);">
      <%= alert %>
    </div>
  </div>
<% end %>
