<footer class="mt-20 md:mt-28 lg:mt-32 border-t" style="border-color: var(--color-olive-30);">
  <div class="container-wide py-12 md:py-16">
    <div class="grid gap-10 md:gap-12 lg:grid-cols-[1.2fr_1fr] items-start">

      <%# Second email capture — footer surface %>
      <section aria-labelledby="footer-cap-title">
        <p class="meta mb-3">Before sunrise</p>
        <h2 id="footer-cap-title" class="display leading-[1.05] m-0" style="font-size: clamp(28px, 4vw, 40px);">
          Start your day<br>
          <span class="italic font-normal">with us.</span>
        </h2>
        <p class="reading mt-4 max-w-[440px]" style="font-size: 17px;">
          A short, true word in your inbox. Two minutes to read. The rest of the day is yours.
        </p>
        <div class="mt-6 max-w-[440px]">
          <%= render "shared/email_capture", source: "footer", autofocus: false %>
        </div>
      </section>

      <%# Footer nav — 2 cols on phones, 4 cols once we have room %>
      <nav class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-6 sm:gap-8 text-[15px]" aria-label="Footer">
        <div>
          <p class="meta mb-4">Read</p>
          <ul class="space-y-3 text-navy">
            <li><%= link_to "Today's devotional", devotionals_today_path, class: "ulink" %></li>
            <li><%= link_to "Archive",            devotionals_path,       class: "ulink" %></li>
            <li><%= link_to "Podcast",            podcast_path,           class: "ulink" %></li>
            <li><%= link_to "Resources",          resources_path,         class: "ulink" %></li>
          </ul>
        </div>
        <div>
          <p class="meta mb-4">Connect</p>
          <ul class="space-y-3 text-navy">
            <li><%= link_to "Prayer wall", pray_path,         class: "ulink" %></li>
            <li><%= link_to "Stories",     testimonies_path,  class: "ulink" %></li>
            <li><%= link_to "Events",      events_path,       class: "ulink" %></li>
            <li><%= link_to "Partner",     partner_path,      class: "ulink" %></li>
            <li><%= link_to "Contact",     contact_page_path, class: "ulink" %></li>
          </ul>
        </div>
        <div>
          <p class="meta mb-4">About</p>
          <ul class="space-y-3 text-navy">
            <li><%= link_to "Mission",             about_page_path,   class: "ulink" %></li>
            <li><%= link_to "Statement of faith",  beliefs_page_path, class: "ulink" %></li>
            <li><%= link_to "Give",                give_path,         class: "ulink" %></li>
          </ul>
        </div>
        <div>
          <p class="meta mb-4">Legal</p>
          <ul class="space-y-3 text-navy">
            <li><%= link_to "Privacy", privacy_page_path, class: "ulink" %></li>
            <li><%= link_to "Terms",   terms_page_path,   class: "ulink" %></li>
          </ul>
        </div>
      </nav>
    </div>

    <hr class="hairline my-12">

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-[13px]" style="color: var(--color-olive);">
      <p>© <%= Date.current.year %> IMPACT Ministry, Inc. Mississippi.</p>
      <p class="italic" style="font-family: var(--font-serif);">
        “Write the vision; make it plain.” — Habakkuk 2:2
      </p>
    </div>
  </div>
</footer>
