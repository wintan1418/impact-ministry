<%# Top nav — direct port of design/source/components/shell.jsx
    Wordmark = Mark SVG (circle + crossed "I") + IMPACT MINISTRY in serif caps.
    Right side: 6 ulinks + search icon + crimson "Give" CTA.
    Hidden below 880px; hamburger drawer takes over. %>
<nav class="nav" data-controller="scroll-nav mobile-nav" aria-label="Primary">
  <div class="container-page flex items-center justify-between" style="height: 72px;">

    <%# ---- Wordmark ---- %>
    <%= link_to root_path, class: "flex items-center gap-3 shrink-0", "aria-label": "IMPACT Ministry — home" do %>
      <svg width="30" height="30" viewBox="0 0 40 40" fill="none" stroke="var(--color-navy)" stroke-width="1.2" aria-hidden="true">
        <circle cx="20" cy="20" r="18"/>
        <path d="M20 9v22" stroke-width="1.6"/>
        <path d="M14.5 14.5h11" stroke-width="1.6"/>
      </svg>
      <span style="font-family: var(--font-serif); color: var(--color-navy); letter-spacing: 0.12em; font-weight: 500; font-size: 15px; text-transform: uppercase;">
        Impact <span style="color: var(--color-olive); font-weight: 400;">Ministry</span>
      </span>
    <% end %>

    <%# ---- Desktop links ---- %>
    <div class="nav-links flex items-center" style="gap: 28px;">
      <%= link_to "Devotional",  devotionals_today_path, class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Archive",     devotionals_path,       class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Podcast",     "#",                    class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Prayer Wall", "#",                    class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "About",       about_page_path,        class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Partner",     "#",                    class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>

      <%# Search icon (overlay opens in Phase 2 search ticket) %>
      <button type="button"
              class="nav-link inline-flex items-center justify-center"
              style="background: transparent; border: 0; padding: 6px; color: var(--color-navy);"
              aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <%# Primary CTA — Give %>
      <a href="#" class="btn btn-primary nav-link" style="padding: 10px 18px; font-size: 14px;">Give</a>
    </div>

    <%# ---- Hamburger (mobile, < 880px) ---- %>
    <button type="button"
            class="menu-btn inline-flex items-center justify-center"
            style="background: transparent; border: 0; padding: 8px; color: var(--color-navy);"
            data-action="mobile-nav#toggle"
            data-mobile-nav-target="button"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Open menu">
      <svg data-mobile-nav-target="iconOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="17" x2="21" y2="17"/>
      </svg>
      <svg data-mobile-nav-target="iconClose" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" style="display: none;">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>

  <%# ---- Mobile drawer ---- %>
  <div id="mobile-menu"
       data-mobile-nav-target="menu"
       class="mobile-menu border-t"
       style="border-color: var(--color-olive-30); background: rgba(250,247,242,0.98); backdrop-filter: blur(8px);">
    <div class="container-page py-8 flex flex-col gap-5">
      <%= link_to "Devotional",  devotionals_today_path, style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Archive",     devotionals_path,       style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Podcast",     "#",                    style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Prayer Wall", "#",                    style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "About",       about_page_path,        style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Partner",     "#",                    style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Give",        "#",                    class: "btn btn-primary self-start mt-3", style: "padding: 12px 22px;" %>
      <% if signed_in? %>
        <%= link_to "Account", "#", class: "ulink", style: "font-size: 14px; color: var(--color-olive); margin-top: 8px;" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "ulink", style: "font-size: 14px; color: var(--color-olive); margin-top: 8px;" %>
      <% end %>
    </div>
  </div>
</nav>
