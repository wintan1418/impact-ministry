<nav class="nav" data-controller="scroll-nav mobile-nav" aria-label="Primary">
  <div class="container-wide flex items-center justify-between py-4 md:py-5">

    <%= link_to root_path, class: "flex items-center gap-3 shrink-0", "aria-label": "IMPACT Ministry — home" do %>
      <%= image_tag "/icon.svg", alt: "", aria: { hidden: "true" }, class: "w-8 h-8 hidden sm:block" %>
      <span class="display text-[20px] sm:text-[22px] tracking-tight">IMPACT</span>
      <span class="meta hidden sm:inline">Ministry</span>
    <% end %>

    <%# Desktop links — tighter at md, looser at lg %>
    <div class="hidden md:flex items-center gap-5 lg:gap-9 text-[14px] lg:text-[15px] text-navy">
      <%= link_to "Today",       devotionals_today_path, class: "ulink" if respond_to?(:devotionals_today_path) %>
      <%= link_to "Devotionals", devotionals_path,       class: "ulink" if respond_to?(:devotionals_path) %>
      <%= link_to "Podcast",     "#",                    class: "ulink" %>
      <%= link_to "Pray",        "#",                    class: "ulink" %>
      <%= link_to "Give",        "#",                    class: "ulink" %>
      <%= link_to "About",       about_page_path,        class: "ulink" if respond_to?(:about_page_path) %>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <% if signed_in? %>
        <%= link_to "Account", "#", class: "btn btn-ghost", style: "padding: 9px 16px; font-size: 14px;" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "btn btn-ghost hidden sm:inline-flex", style: "padding: 9px 16px; font-size: 14px;" %>
      <% end %>

      <%# Mobile menu toggle — visible below lg %>
      <button type="button"
              class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full"
              style="border: 1px solid var(--color-olive-30);"
              data-action="mobile-nav#toggle"
              data-mobile-nav-target="button"
              aria-controls="mobile-menu"
              aria-expanded="false"
              aria-label="Open menu">
        <svg data-mobile-nav-target="iconOpen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="17" x2="21" y2="17"/>
        </svg>
        <svg data-mobile-nav-target="iconClose" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"/>
          <line x1="6" y1="18" x2="18" y2="6"/>
        </svg>
      </button>
    </div>
  </div>

  <%# Mobile drawer %>
  <div id="mobile-menu"
       data-mobile-nav-target="menu"
       class="md:hidden hidden border-t"
       style="border-color: var(--color-olive-30); background: rgba(250, 247, 242, 0.98); backdrop-filter: blur(8px);">
    <div class="container-wide py-6 flex flex-col gap-1 text-[17px]">
      <%= link_to "Today's devotional", (respond_to?(:devotionals_today_path) ? devotionals_today_path : "#"), class: "py-3 ulink" %>
      <%= link_to "Archive",            (respond_to?(:devotionals_path) ? devotionals_path : "#"),       class: "py-3 ulink" %>
      <%= link_to "Podcast",            "#",                  class: "py-3 ulink" %>
      <%= link_to "Pray",               "#",                  class: "py-3 ulink" %>
      <%= link_to "Give",               "#",                  class: "py-3 ulink" %>
      <%= link_to "About",              (respond_to?(:about_page_path) ? about_page_path : "#"), class: "py-3 ulink" %>
      <hr class="hairline my-3">
      <% if signed_in? %>
        <%= link_to "Account", "#", class: "py-3 ulink" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "py-3 ulink" %>
      <% end %>
    </div>
  </div>
</nav>
