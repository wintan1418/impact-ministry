<%# Top nav — ports design/source/components/shell.jsx.
    Wordmark + 6 ulinks + "More" mega-menu + search + crimson "Give".
    Below 880px the desktop strip is hidden and the hamburger drawer
    takes over (the drawer lists every surface — no orphaned routes). %>
<nav class="nav" data-controller="scroll-nav mobile-nav" aria-label="Primary">
  <div class="container-page flex items-center justify-between" style="height: 72px;">

    <%# ---- Wordmark ---- %>
    <%= link_to root_path, class: "flex items-center gap-3 shrink-0", "aria-label": "IMPACT Ministry — home" do %>
      <svg width="30" height="30" viewBox="0 0 40 40" fill="none" stroke="var(--color-navy)" stroke-width="1.2" aria-hidden="true">
        <circle cx="20" cy="20" r="18"/>
        <path d="M20 9v22" stroke-width="1.6"/>
        <path d="M14.5 14.5h11" stroke-width="1.6"/>
      </svg>
      <span style="font-family: var(--font-serif); color: var(--color-navy); letter-spacing: 0.12em; font-weight: 500; font-size: 15px; text-transform: uppercase;">
        Impact <span style="color: var(--color-olive); font-weight: 400;">Ministry</span>
      </span>
    <% end %>

    <%# ---- Desktop links ---- %>
    <div class="nav-links" style="gap: 28px;">
      <%= link_to "Devotional",  devotionals_today_path, class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Archive",     devotionals_path,       class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Podcast",     podcast_path,           class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "Prayer Wall", pray_path,              class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <%= link_to "About",       about_page_path,        class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>

      <%# More — hover trigger for the mega-menu. tabindex makes it
          keyboard-focusable; :focus-within keeps the panel open during
          tab navigation through child links. %>
      <div class="nav-more" tabindex="0">
        <span class="nav-link ulink" style="font-size: 14px; color: var(--color-navy); cursor: default; display: inline-flex; align-items: center; gap: 6px;">
          More
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <polyline points="2,4 5,7 8,4"/>
          </svg>
        </span>

        <%# ---- Mega-menu panel ---- %>
        <div class="nav-mega" role="menu" aria-label="More links">
          <div class="container-page nav-mega-grid">
            <div class="nav-mega-col">
              <p class="meta">Read</p>
              <ul>
                <li><%= link_to "Today's devotional", devotionals_today_path, class: "nav-mega-link" %></li>
                <li><%= link_to "Archive",            devotionals_path,       class: "nav-mega-link" %></li>
                <li><%= link_to "Podcast",            podcast_path,           class: "nav-mega-link" %></li>
                <li><%= link_to "Resources",          resources_path,         class: "nav-mega-link" %></li>
              </ul>
            </div>
            <div class="nav-mega-col">
              <p class="meta">Connect</p>
              <ul>
                <li><%= link_to "Prayer wall",     pray_path,         class: "nav-mega-link" %></li>
                <li><%= link_to "Stories",         testimonies_path,  class: "nav-mega-link" %></li>
                <li><%= link_to "Events",          events_path,       class: "nav-mega-link" %></li>
                <li><%= link_to "Share your story", new_testimony_path, class: "nav-mega-link" %></li>
              </ul>
            </div>
            <div class="nav-mega-col">
              <p class="meta">About</p>
              <ul>
                <li><%= link_to "Mission",            about_page_path,   class: "nav-mega-link" %></li>
                <li><%= link_to "Statement of faith", beliefs_page_path, class: "nav-mega-link" %></li>
                <li><%= link_to "Partner",            partner_path,      class: "nav-mega-link" %></li>
                <li><%= link_to "Contact",            contact_page_path, class: "nav-mega-link" %></li>
              </ul>
            </div>
            <div class="nav-mega-col">
              <p class="meta">Account</p>
              <ul>
                <% if signed_in? %>
                  <li><%= link_to "Your account",     account_path,             class: "nav-mega-link" %></li>
                  <li><%= link_to "Saved highlights", account_highlights_path,  class: "nav-mega-link" %></li>
                  <li><%= link_to "Settings",         account_settings_path,    class: "nav-mega-link" %></li>
                  <li><%= button_to "Sign out", session_path, method: :delete, form: { style: "margin:0;" }, style: "background: none; border: 0; padding: 0; color: inherit; cursor: pointer; font: inherit; text-align: left;", class: "nav-mega-link" %></li>
                <% else %>
                  <li><%= link_to "Sign in",        new_session_path, class: "nav-mega-link" %></li>
                  <li><%= link_to "Start reading",  new_user_path,    class: "nav-mega-link", style: "color: var(--color-crimson); font-weight: 500;" %></li>
                  <li><%= link_to "Forgot password?", new_password_path, class: "nav-mega-link" %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <%# Search icon — overlay opens in Phase 2 search ticket %>
      <button type="button"
              class="nav-link inline-flex items-center justify-center"
              style="background: transparent; border: 0; padding: 6px; color: var(--color-navy);"
              aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <%# Account affordance — Sign in / account-link when authed, Sign up + Sign in pair when not %>
      <% if signed_in? %>
        <%= link_to "Your account", account_path, class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy);" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "ulink nav-link", style: "font-size: 14px; color: var(--color-olive);" %>
        <%= link_to "Sign up", signup_path,      class: "ulink nav-link", style: "font-size: 14px; color: var(--color-navy); font-weight: 500;" %>
      <% end %>

      <%# Primary CTA — Give %>
      <%= link_to "Give", give_path, class: "btn btn-primary nav-link", style: "padding: 10px 18px; font-size: 14px;" %>
    </div>

    <%# ---- Hamburger (mobile, < 880px) ---- %>
    <button type="button"
            class="menu-btn"
            style="background: transparent; border: 0; padding: 8px; color: var(--color-navy);"
            data-action="mobile-nav#toggle"
            data-mobile-nav-target="button"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Open menu">
      <svg data-mobile-nav-target="iconOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="17" x2="21" y2="17"/>
      </svg>
      <svg data-mobile-nav-target="iconClose" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" style="display: none;">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>

  <%# ---- Mobile drawer ---- %>
  <div id="mobile-menu"
       data-mobile-nav-target="menu"
       class="mobile-menu border-t"
       style="border-color: var(--color-olive-30); background: rgba(250,247,242,0.98); backdrop-filter: blur(8px);">
    <div class="container-page py-8 flex flex-col gap-5">
      <%= link_to "Devotional",  devotionals_today_path, style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Archive",     devotionals_path,       style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Podcast",     podcast_path,           style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Resources",   resources_path,         style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Stories",     testimonies_path,       style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Prayer Wall", pray_path,              style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Events",      events_path,            style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "About",       about_page_path,        style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Partner",     partner_path,           style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Contact",     contact_page_path,      style: "font-family: var(--font-serif); font-size: 28px; color: var(--color-navy);" %>
      <%= link_to "Give",        give_path,              class: "btn btn-primary self-start mt-3", style: "padding: 12px 22px;" %>
      <% if signed_in? %>
        <%= link_to "Your account", account_path, class: "ulink", style: "font-size: 14px; color: var(--color-olive); margin-top: 8px;" %>
      <% else %>
        <div class="flex flex-wrap gap-4 mt-3">
          <%= link_to "Sign in",  new_session_path, class: "ulink", style: "font-size: 14px; color: var(--color-olive);" %>
          <%= link_to "Start reading", new_user_path,  class: "ulink", style: "font-size: 14px; color: var(--color-navy); font-weight: 500;" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
