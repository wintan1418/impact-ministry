<% content_for :title, "Sign in — IMPACT Ministry" %>

<section class="container-read" style="padding-top: 96px; padding-bottom: 120px;">
  <p class="meta">Sign in</p>
  <h1 class="display mt-4" style="font-size: clamp(40px, 5vw, 60px); line-height: 1.05;">
    Welcome back.
  </h1>
  <p class="reading mt-4" style="font-size: 17px;">
    Sign in to see your streak, your saved highlights, and tomorrow's word.
  </p>

  <%= form_with url: session_url, class: "mt-10" do |form| %>
    <div class="space-y-6">
      <div>
        <%= form.label :email_address, "Email address", class: "meta block mb-2" %>
        <%= form.email_field :email_address,
                              required: true,
                              autofocus: true,
                              autocomplete: "username",
                              placeholder: "you@example.com",
                              value: params[:email_address],
                              "aria-label": "Email address",
                              class: "input" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "meta block mb-2" %>
        <%= form.password_field :password,
                                 required: true,
                                 autocomplete: "current-password",
                                 placeholder: "your password",
                                 maxlength: 72,
                                 "aria-label": "Password",
                                 class: "input" %>
      </div>

      <div class="flex items-center justify-between flex-wrap gap-4 pt-2">
        <%= form.submit "Sign in", class: "btn btn-primary" %>
        <%= link_to "Forgot password?", new_password_path, class: "ulink", style: "color: var(--color-olive); font-size: 14px;" %>
      </div>
    </div>
  <% end %>

  <hr class="hairline" style="margin: 56px 0 28px;">

  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <p class="m-0" style="font-family: var(--font-serif); font-style: italic; font-size: 17px; color: var(--color-navy);">
      New to IMPACT?
    </p>
    <%= link_to signup_path, class: "btn btn-ghost", style: "padding: 10px 18px; font-size: 14px;" do %>
      Start reading <span aria-hidden="true">→</span>
    <% end %>
  </div>
</section>
