<%#
  Quiet post-submit confirmation. Replaces the prayer-form turbo-frame.
  Single olive-italic line — no confetti, no toast. CLAUDE.md §11 (voice).
%>
<turbo-frame id="prayer-form">
  <div class="card" style="padding: 56px 36px; background: var(--color-navy); color: var(--color-cream); border-color: var(--color-navy); text-align: center;">
    <p class="meta" style="color: rgba(250,247,242,0.65); margin-bottom: 12px;">Received</p>
    <h3 class="display" style="font-size: 32px; line-height: 1.15; color: var(--color-cream); margin: 0 0 14px;">
      We've received your prayer.
    </h3>
    <p class="reading" style="font-family: var(--font-serif); font-style: italic; color: rgba(250,247,242,0.85); max-width: 460px; margin: 0 auto; font-size: 17px;">
      We'll pray with you today.
    </p>
  </div>
</turbo-frame>
