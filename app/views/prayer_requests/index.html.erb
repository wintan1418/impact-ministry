<% content_for :title, "Prayer wall — IMPACT Ministry" %>
<% content_for :description, "A quiet place where strangers carry each other's weight for a few minutes a day." %>

<section class="pt-10 md:pt-16 pb-16 md:pb-24">
  <div class="container-page">
    <div class="grid gap-10 md:gap-14 lg:grid-cols-[1fr_1.05fr] items-center">
      <div>
        <p class="meta mb-5">Prayer wall</p>
        <h1 class="display m-0" style="font-size: clamp(36px, 5.5vw, 72px); line-height: 1.0; letter-spacing: -0.02em;">
          We're praying<br>
          <span class="italic font-normal">with you.</span>
        </h1>
        <p class="reading mt-6 max-w-[520px]" style="font-size: 19px;">
          A small, quiet place where you can name what's heavy — anonymously if you'd
          like — and where strangers will agree to carry it with you for a few minutes
          a day. The wall opens in the next release.
        </p>

        <div class="mt-9 max-w-[480px]">
          <p class="meta mb-3">Tell me when it opens</p>
          <%= render "shared/email_capture", source: "prayer" %>
        </div>

        <p class="mt-9 text-sm" style="color: var(--color-olive); font-style: italic; font-family: var(--font-serif); max-width: 480px;">
          "Bear one another's burdens, and so fulfill the law of Christ." — Galatians 6:2
        </p>
      </div>

      <div class="relative">
        <%= image_tag photo_url("praying-hands", w: 720, h: 860), alt: "Folded hands in warm light", class: "w-full h-auto", style: "border-radius: var(--radius-image); aspect-ratio: 4 / 5; object-fit: cover;" %>
      </div>
    </div>
  </div>
</section>

<%# ============================================================
     What we'll do — three cards
     ============================================================ %>
<section class="pb-20 md:pb-28">
  <div class="container-page">
    <p class="meta mb-8 text-center">When the wall opens</p>
    <div class="grid gap-6 md:gap-8 md:grid-cols-3">
      <% [
        { title: "Submit in two minutes", body: "A short, calm form. Anonymous is a toggle, not a chore. No sign-up required." },
        { title: "Strangers will pray",   body: "Members tap a small flame next to your request when they've prayed for you. We'll let you know how many." },
        { title: "Mark it answered",      body: "When God moves, you can come back and tell the wall. Answered prayers carry a quiet badge." }
      ].each do |card| %>
        <div class="card p-7 md:p-8">
          <p class="display m-0" style="font-size: 24px; line-height: 1.15;"><%= card[:title] %></p>
          <p class="reading mt-3 m-0" style="font-size: 16px;"><%= card[:body] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
