<% content_for :title, "Prayer wall — IMPACT Ministry" %>
<% content_for :description, "A quiet place to name what's heavy and let strangers carry it with you." %>

<% prayed_for_ids = (session[:prayed_for] || []).map(&:to_i) %>

<%# ============================================================
     Hero — heading + intro + photo
     ============================================================ %>
<section style="padding: 60px 0 30px;">
  <div class="container-page" style="max-width: 880px;">
    <p class="meta" style="margin-bottom: 14px;">The Prayer Wall</p>
    <h1 class="display m-0" style="font-size: clamp(44px, 5.5vw, 72px); line-height: 1.02; margin-bottom: 24px;">
      Tell us what to <span class="italic font-normal">pray for.</span>
    </h1>
    <p class="reading" style="font-size: 19px; max-width: 620px; margin: 0;">
      Submit a request — anonymously if you want. Our team reads every one.
      Others on this page can pray with you, quietly, by tapping the flame.
    </p>
  </div>
</section>

<%# Decorative hero photo, kept narrow so the form remains the focal point. %>
<section style="padding: 12px 0 20px;">
  <div class="container-page" style="max-width: 880px;">
    <%= image_tag photo_url("praying-hands", w: 1400, h: 560),
                  alt: "Folded hands in warm light",
                  class: "w-full h-auto",
                  style: "border-radius: var(--radius-image); aspect-ratio: 5 / 2; object-fit: cover;" %>
  </div>
</section>

<%# ============================================================
     Submission form — the hero centerpiece
     ============================================================ %>
<section style="padding: 28px 0 64px;">
  <div class="container-page" style="max-width: 880px;">
    <%= render "form", prayer_request: @prayer_request %>
  </div>
</section>

<%# ============================================================
     Wall meta — total prayers count
     ============================================================ %>
<section style="padding: 0 0 24px;">
  <div class="container-page flex flex-wrap items-center justify-between"
       style="max-width: 880px; gap: 16px;">
    <p class="meta" style="margin: 0;">
      Recent requests · <%= @public_requests.size %>
      <% if @total_prayed.to_i > 0 %>
        · <%= number_with_delimiter(@total_prayed) %> prayers offered
      <% end %>
    </p>

    <div class="flex" style="gap: 8px;">
      <%= link_to "All",
                  pray_path,
                  class: "chip #{'chip-active' if @filter == 'all'}" %>
      <%= link_to "Answered ✓",
                  pray_path(filter: "answered"),
                  class: "chip #{'chip-active' if @filter == 'answered'}" %>
    </div>
  </div>
</section>

<%# ============================================================
     The wall
     ============================================================ %>
<section style="padding-bottom: 80px;">
  <div class="container-page" style="max-width: 880px;">
    <% if @public_requests.any? %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% @public_requests.each do |req| %>
          <%= render "prayer_card", req: req, prayed: prayed_for_ids.include?(req.id) %>
        <% end %>
      </div>
    <% else %>
      <div class="card" style="padding: 36px; text-align: center; background: rgba(255,255,255,0.5);">
        <p class="reading" style="font-family: var(--font-serif); font-style: italic; color: var(--color-olive); margin: 0;">
          The wall is quiet right now. Add the first request above and we'll begin.
        </p>
      </div>
    <% end %>

    <p class="scripture" style="margin-top: 48px; text-align: center; font-size: 17px;">
      "Bear one another's burdens, and so fulfill the law of Christ." — Galatians 6:2
    </p>
  </div>
</section>
