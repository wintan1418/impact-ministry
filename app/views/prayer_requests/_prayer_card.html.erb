<%#
  One prayer wall card. Wrapped in a turbo-frame so the whole card can be
  replaced (e.g. after an admin marks answered). The flame button posts to
  /pray/:id/prayed and the inner `prayed_<id>` frame swaps with the new
  counter (see _prayed_counter.html.erb).

  Locals:
    req:    PrayerRequest
    prayed: Boolean — whether this session has already prayed for `req`
%>
<turbo-frame id="prayer_<%= req.id %>">
  <article class="card" style="padding: 28px; background: rgba(255,255,255,0.55); position: relative;">
    <div class="flex items-baseline justify-between" style="margin-bottom: 14px; gap: 12px;">
      <div class="flex items-center" style="gap: 10px; min-width: 0;">
        <span style="font-family: var(--font-serif); font-size: 17px; color: var(--color-navy);">
          <%= req.display_name %>
        </span>
        <span class="meta" style="font-size: 11px;">· <%= time_ago_in_words(req.created_at) %> ago</span>
      </div>

      <% if req.status_answered? %>
        <span class="inline-flex items-center"
              style="gap: 6px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--color-olive-30); font-size: 11px; color: var(--color-olive); letter-spacing: 0.06em; text-transform: uppercase;">
          <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Answered
        </span>
      <% end %>
    </div>

    <p class="reading" style="font-size: 17px; line-height: 1.6; margin: 0 0 22px;">
      <%= req.body %>
    </p>

    <div class="flex items-center justify-between flex-wrap" style="gap: 12px;">
      <%= render "prayed_button", req: req, prayed: prayed %>
      <%= render "prayed_counter", req: req %>
    </div>
  </article>
</turbo-frame>
