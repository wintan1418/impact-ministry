<% content_for :title, "Settings — IMPACT Ministry" %>

<section class="container-read" style="padding-top: 60px; padding-bottom: 96px;">
  <%= link_to "← Back to your account", account_path, class: "ulink", style: "font-size: 13px; color: var(--color-olive);" %>
  <p class="meta mt-6">Account</p>
  <h1 class="display mt-3" style="font-size: clamp(36px, 5vw, 56px); line-height: 1.05;">
    Settings.
  </h1>

  <%= form_with model: current_user, url: account_settings_path, method: :patch, class: "mt-10" do |form| %>
    <% if current_user.errors.any? %>
      <div class="card" style="background: rgba(200, 16, 46, 0.06); border-color: var(--color-crimson); padding: 14px 18px; margin-bottom: 24px;">
        <ul class="m-0" style="color: var(--color-crimson); font-size: 14px; padding-left: 20px;">
          <% current_user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-7">
      <div>
        <%= form.label :name, "Name", class: "meta block mb-2" %>
        <%= form.text_field :name, autocomplete: "name", class: "input", "aria-label": "Name" %>
      </div>

      <div>
        <p class="meta block mb-2">Email address</p>
        <p class="m-0" style="font-family: var(--font-serif); font-size: 18px; color: var(--color-navy);">
          <%= current_user.email_address %>
        </p>
        <p class="input-help">Email changes go through a confirmation step — coming soon.</p>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 pt-3" style="border-top: 1px solid var(--color-olive-15);">
        <%= form.submit "Save", class: "btn btn-primary" %>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost" %>
      </div>
    </div>
  <% end %>
</section>
