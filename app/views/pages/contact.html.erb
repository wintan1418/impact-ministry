<%#
  Bespoke template for the seeded /contact Page. Renders the editor-managed
  body (the dignified intro copy seeded into the Page record), then renders
  the FeedbackMessage submission form below.

  Picked up automatically by PagesController#render_for_slug because a
  template exists at `pages/<slug>` for slug == "contact".
%>
<% content_for :title,       @page_title %>
<% content_for :description, @page_description if @page_description %>

<article class="page-enter" style="padding: 80px 0 96px;">
  <header class="container-read" style="margin-bottom: 40px;">
    <div class="meta" style="margin-bottom: 18px;"><%= @page.title %></div>
    <h1 class="display m-0" style="font-size: clamp(44px, 5.5vw, 76px); line-height: 1.0;">
      <%= @page.title %>
    </h1>
    <p class="m-0" style="margin-top: 14px; font-family: var(--font-serif); font-style: italic; font-size: 15px; color: var(--color-olive);">
      Write to us. We read every note.
    </p>
  </header>

  <div class="container-read reading">
    <%= @page.body %>
  </div>

  <div class="container-read" style="margin-top: 56px;">
    <hr class="hairline" style="margin: 0 0 40px;">
    <div class="meta" style="margin-bottom: 12px;">Send us a note</div>
    <p class="m-0" style="font-family: var(--font-serif); font-style: italic; font-size: 22px; color: var(--color-navy); margin-bottom: 24px;">
      Tell us what's on your mind — we'll read it carefully.
    </p>
    <%= render "feedback_messages/form", feedback_message: FeedbackMessage.new %>
  </div>
</article>
