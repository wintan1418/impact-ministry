<% content_for :title, "Partner with us — IMPACT Ministry" %>
<% content_for :description, "Let's build something together — partnerships for churches, nonprofits, schools, and businesses." %>

<section class="pt-10 md:pt-16 pb-16 md:pb-24">
  <div class="container-page">
    <div class="grid gap-10 md:gap-14 lg:grid-cols-[1.05fr_1fr] items-center">
      <div>
        <p class="meta mb-5">Partner</p>
        <h1 class="display m-0" style="font-size: clamp(40px, 6vw, 80px); line-height: 0.98; letter-spacing: -0.02em;">
          Let's build something<br>
          <span class="italic font-normal">together.</span>
        </h1>
        <p class="reading mt-6 max-w-[540px]" style="font-size: 19px;">
          We work alongside churches, schools, and small businesses across Mississippi
          and beyond. The intake form opens with our Phase 3 release. Until then,
          leave a note and we'll write you back ourselves.
        </p>

        <div class="mt-9 max-w-[480px]">
          <p class="meta mb-3">Hear from us first</p>
          <%= render "shared/email_capture", source: "podcast" %>
        </div>
      </div>

      <div>
        <%= image_tag photo_url("handshake", w: 720, h: 860), alt: "A warm handshake between two people", class: "w-full h-auto", style: "border-radius: var(--radius-image); aspect-ratio: 4 / 5; object-fit: cover;" %>
      </div>
    </div>
  </div>
</section>

<%# ============================================================
     Three audiences — cards
     ============================================================ %>
<section class="pb-20 md:pb-28">
  <div class="container-page">
    <p class="meta mb-8 text-center">Who we work with</p>
    <div class="grid gap-6 md:gap-8 md:grid-cols-3">
      <% [
        { meta: "For churches",        title: "Pulpit & content partnerships",  body: "Co-published devotionals, guest writers, podcast crossovers, small-church design grants." },
        { meta: "For nonprofits & schools", title: "Funding & ops support",     body: "Small operational grants, design and copy help, leadership coaching for executive directors." },
        { meta: "For businesses",      title: "Mission-aligned sponsorship",    body: "Underwrite a season of the podcast, sponsor a devotional series, donate goods or services." }
      ].each do |card| %>
        <div class="card p-7 md:p-8">
          <p class="meta m-0"><%= card[:meta] %></p>
          <p class="display m-0 mt-2" style="font-size: 22px; line-height: 1.2;"><%= card[:title] %></p>
          <p class="reading mt-3 m-0" style="font-size: 16px;"><%= card[:body] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
