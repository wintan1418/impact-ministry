<%# Bare overlay shell rendered without the application layout. Used when a
    visitor lands on /search/overlay directly — the Stimulus controller already
    embeds the same markup in the nav, so this is mostly a no-JS fallback. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Search — IMPACT Ministry</title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app %>
  </head>
  <body>
    <div class="container-page" style="padding: 60px 0;">
      <%= form_with url: search_path, method: :get, data: { controller: "search" }, local: true do |f| %>
        <%= f.search_field :q,
              placeholder: "Search devotionals, scripture, episodes…",
              autocomplete: "off",
              autofocus: true,
              class: "input" %>
      <% end %>

      <turbo-frame id="search-results" style="display: block; margin-top: 24px;">
      </turbo-frame>
    </div>
  </body>
</html>
